<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for API 31+: cloud backup to Google Drive and
     direct device-to-device transfer during new-phone setup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="tasks.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="tasks.db" />
    </device-transfer>
</data-extraction-rules>
